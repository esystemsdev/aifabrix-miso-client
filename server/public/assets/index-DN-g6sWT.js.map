{
    "mergeWithHardcodedDefaults": true,
    "substringMinLength": 4,
    "neverMaskFields": [
        "success",
        "key",
        "message",
        "status",
        "error",
        "hint",
        "code",
        "name",
        "id"
    ],
    "fields": {
        "authentication": [
            "password",
            "passwd",
            "pwd",
            "token",
            "secret",
            "auth",
            "authorization"
        ],
        "pii": ["ssn", "creditcard", "cvv", "pin", "otp"],
        "security": [
            "apikey",
            "accesstoken",
            "refreshtoken",
            "privatekey",
            "secretkey",
            "cookie",
            "session",
            "encryptionkey",
            "encryptionKey"
        ]
    },
    "fieldPatterns": []
}
